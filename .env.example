# usmanishaq.com: set every value in Vercel (Project, Settings, Environment Variables)
# and in .env.local for local development. Never commit .env.local.

# Public origin. Canonicals, sitemap and schema resolve against it.
NEXT_PUBLIC_SITE_URL=https://usmanishaq.com

# Supabase Postgres (Supabase, Project, Connect, ORMs, Prisma)
# Pooled connection (port 6543) for runtime
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432); only the Prisma CLI uses it (db:push, db:seed)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Dashboard login (Auth.js). AUTH_SECRET is any long random string.
AUTH_URL=https://usmanishaq.com
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Hours a dashboard sign-in lasts (default 8)
ADMIN_SESSION_HOURS=8

# Supabase Storage (media library). Create a PUBLIC bucket with this name.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET="usman-ishaq-media"

# Sign-in code (second step). The six-digit code is always emailed to this inbox.
TWO_FACTOR_EMAIL=
# SMTP mailbox the code is sent from. Without SMTP the code is printed in the
# server log, in development only.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# First admin user, used only by `npm run db:seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Usman Ishaq

# Sign-in protection (optional)
# Failed passwords per IP before it is blocked (default 3; editable in Settings)
LOGIN_BLOCK_THRESHOLD=
# IPs that are never blocked, comma separated
LOGIN_BLOCK_ALLOWLIST=

# seo-engine publishing (POST /api/ingest/posts). Token is `openssl rand -hex 32`; same value goes in seo-engine .env
CONTENT_API_TOKEN=
# Admin user ingested posts are attributed to (optional; defaults to the first admin)
CONTENT_API_USER_EMAIL=
